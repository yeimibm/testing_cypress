{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "@coffee/e2e#build": { "dependsOn": ["^build"], "outputs": [] },
    "dev": { "dependsOn": ["^build"], "persistent": true, "cache": false, "env": ["PORT", "DATABASE_PATH", "NODE_ENV"] },
    "lint": { "cache": false },
    "typecheck": { "dependsOn": ["^build"], "cache": false },
    "test": { "dependsOn": ["^build"], "cache": false, "env": ["DATABASE_PATH", "NODE_ENV"] },
    "db:generate": { "cache": false },
    "db:migrate": { "cache": false },
    "db:seed": { "cache": false },
    "db:reset": { "cache": false }
  }
}
