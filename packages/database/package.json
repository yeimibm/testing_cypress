{
  "name": "@coffee/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./testing": { "types": "./dist/testing.d.ts", "import": "./dist/testing.js" } },
  "scripts": { "build": "tsc -p tsconfig.json", "dev": "tsc -p tsconfig.json --watch", "typecheck": "tsc -p tsconfig.json --noEmit", "lint": "eslint src scripts tests", "test": "vitest run", "db:generate": "pnpm build && drizzle-kit generate", "db:migrate": "tsx scripts/migrate.ts", "db:seed": "tsx scripts/seed.ts", "db:reset": "tsx scripts/reset.ts" },
  "dependencies": { "better-sqlite3": "12.4.1", "drizzle-orm": "0.44.7" },
  "devDependencies": { "@types/better-sqlite3": "7.6.13", "@types/node": "22.15.30", "drizzle-kit": "0.31.4", "tsx": "4.20.6", "typescript": "5.9.3", "vitest": "3.2.4" }
}
